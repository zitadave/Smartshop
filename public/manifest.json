    },
    {
      "name": "Active Group Buys",
      "short_name": "Group Buy",
      "description": "Collaborate with peers to save up to 25%",
      "url": "/my-group-deals",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" }]
    },
    {
      "name": "Track Orders",
      "short_name": "Orders",
